{
  "name": "DemoSettings",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "agent",
        "client",
        "broker",
        "superadmin"
      ],
      "description": "Role type for this counter"
    },
    "counter": {
      "type": "number",
      "default": 1,
      "description": "Current auto-increment counter for this role"
    }
  },
  "required": [
    "role"
  ]
}