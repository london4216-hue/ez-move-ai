{
  "name": "Client",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Reference to the Agent who invited this client"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the client user"
    },
    "user_name": {
      "type": "string",
      "description": "Client's full name"
    },
    "phone": {
      "type": "string",
      "description": "Client's phone number"
    },
    "sms_opt_in": {
      "type": "boolean",
      "default": true,
      "description": "Whether the client has opted in to SMS"
    },
    "last_sms_sent": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last SMS sent"
    },
    "last_sms_message": {
      "type": "string",
      "description": "Content of the last SMS sent"
    },
    "sms_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "description": "Status of the last SMS"
    },
    "sms_reply": {
      "type": "string",
      "description": "Last reply received from the client via SMS"
    },
    "home_address": {
      "type": "string",
      "description": "Destination property address (moving TO)"
    },
    "moving_from_address": {
      "type": "string",
      "description": "Current/origin address (moving FROM)"
    },
    "estimated_miles": {
      "type": "number",
      "description": "Estimated driving miles between origin and destination"
    },
    "close_date": {
      "type": "string",
      "format": "date",
      "description": "Estimated closing date"
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "registered",
        "active",
        "completed"
      ],
      "default": "invited",
      "description": "Client lifecycle status"
    },
    "invitation_code": {
      "type": "string",
      "description": "Unique code for client invite link"
    },
    "invited_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the client was invited"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "pending",
        "charged",
        "refunded"
      ],
      "default": "pending",
      "description": "Payment status ($40 charge)"
    },
    "charge_date": {
      "type": "string",
      "format": "date",
      "description": "When the $40 charge was processed"
    }
  },
  "required": [
    "agent_id",
    "invitation_code"
  ]
}