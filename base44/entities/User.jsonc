{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "broker",
        "agent",
        "admin",
        "user"
      ],
      "default": "user",
      "description": "super_admin = EZ Move AI platform staff, broker = broker firm account, agent = individual agent, admin = legacy admin (agent/broker), user = buyer/seller"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "agent",
        "broker"
      ],
      "description": "For admin users: individual agent or broker firm"
    },
    "broker_id": {
      "type": "string",
      "description": "For agent role users: the Agent entity ID of their broker"
    },
    "home_address": {
      "type": "string"
    },
    "estimated_close_date": {
      "type": "string",
      "format": "date"
    },
    "registration_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_move_cost": {
      "type": "string"
    },
    "move_date": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}